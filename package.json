{
  "name": "orca-bot-kit",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "A kit for running a fleet of long-lived role bots on Orca: an obk CLI and the skills the bots use.",
  "bin": {
    "obk": "src/cli.js"
  },
  "files": [
    "src/",
    "rules/",
    "skills/",
    "README.md",
    "SETUP.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:system": "node scripts/test-system.js",
    "mutate": "node scripts/mutate.js"
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "dependencies": {
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.0.0"
  },
  "overrides": {
    "typed-rest-client": {
      "qs": "6.16.0"
    }
  }
}
