{
  "name": "@assuredloop/orca-bot-kit",
  "version": "0.6.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guwenqing/orca-bot-kit.git"
  },
  "bugs": {
    "url": "https://github.com/guwenqing/orca-bot-kit/issues"
  },
  "homepage": "https://github.com/guwenqing/orca-bot-kit#readme",
  "type": "module",
  "description": "A kit for running a fleet of long-lived role bots on Orca: an obk CLI and the skills the bots use.",
  "bin": {
    "obk": "src/cli.js"
  },
  "files": [
    "src/",
    "rules/",
    "skills/",
    "README.md",
    "SETUP.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:system": "node scripts/test-system.js",
    "mutate": "node scripts/mutate.js"
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "dependencies": {
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.0.0"
  },
  "overrides": {
    "typed-rest-client": {
      "qs": "6.16.0"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
